# Public, read-only Horizon endpoint. Mainnet by default (see ARCHITECTURE.md
# for why mainnet over testnet). No API key required.
HORIZON_URL=https://horizon.stellar.org

# Public, read-only Horizon endpoint for testnet. Overrides the default testnet
# endpoint (https://horizon-testnet.stellar.org). No API key required.
HORIZON_TESTNET_URL=https://horizon-testnet.stellar.org

# How often the backend polls Horizon, in milliseconds.
POLL_INTERVAL_MS=6000

# Port the backend HTTP server listens on.
PORT=4000

# Origins allowed to call the REST API and to open the /ws WebSocket
# (frontend dev server by default, so local development needs no change).
# Accepts a comma-separated list when the frontend is served from more than
# one origin, e.g.
#   CORS_ORIGIN=https://netpulse.example,https://www.netpulse.example
# Set this whenever the frontend is deployed to a different origin than the
# backend, otherwise the browser's WebSocket handshake is refused with 403.
# Use * to allow any origin (public read-only deployments only).
# Clients that send no Origin header at all — curl, monitoring scripts,
# container health checks — are always allowed; see backend/src/origins.ts.
CORS_ORIGIN=http://localhost:5173

# Threshold ratio (0.0 - 1.0) above which network congestion is banded "high"
# (default 0.8). Also the threshold that outbound alerting fires on, below.
CONGESTION_ALERT_THRESHOLD=0.8

# --- Outbound congestion alerting (all optional) ---------------------------
#
# Alerting is entirely off unless ALERT_WEBHOOK_URL is set. With it unset the
# backend starts and runs exactly as before; nothing else depends on these.
#
# Where to POST when a network crosses CONGESTION_ALERT_THRESHOLD, and again
# when it recovers. Any endpoint accepting a JSON body works — Discord and
# Slack incoming webhooks are supported directly via ALERT_WEBHOOK_FORMAT.
# Treat this URL as a secret: anyone holding it can post to your channel.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
#
# Body shape to send: generic, discord, or slack (default generic). Discord
# and Slack reject bodies they do not recognise, so this must match the
# service the URL points at.
# ALERT_WEBHOOK_FORMAT=generic
#
# Two independent guards stop a busy network flooding a channel.
#
# Hysteresis: entering the alerting state needs usage >= threshold, but
# leaving it needs usage < threshold - this value (default 0.05). A reading
# flickering either side of the threshold therefore alerts once rather than on
# every poll. Set to 0 to clear at the threshold itself.
# ALERT_HYSTERESIS=0.05
#
# Cooldown: minimum milliseconds between alerts for one network (default
# 900000, 15 minutes), measured from the last notification of either kind.
# This covers the case hysteresis cannot — a value swinging widely across both
# lines. A recovery closing a delivered alert is never suppressed, so a channel
# is not left showing a problem that has passed.
# ALERT_COOLDOWN_MS=900000
#
# How long to wait for the webhook before giving up, in milliseconds
# (default 5000). Delivery never blocks polling and a failure is logged and
# swallowed, so a dead webhook cannot take the dashboard down.
# ALERT_WEBHOOK_TIMEOUT_MS=5000

# Path to persistent SQLite database file (defaults to ./data/netpulse.db).
DATABASE_PATH=./data/netpulse.db

# Minimum log level: debug, info, warn, error, or silent (defaults to info, silent in test).
LOG_LEVEL=info

# How long graceful shutdown may take, in milliseconds, before the process
# forces an exit (defaults to 8000). On SIGTERM/SIGINT the backend stops
# accepting connections, drains in-flight requests, closes WebSockets and the
# Horizon streams, then closes the database. Keep this below the grace period
# your platform allows between SIGTERM and SIGKILL — 10s for Docker and
# systemd by default — so the process can report a failure to drain instead of
# being killed mid-cleanup.
SHUTDOWN_TIMEOUT_MS=8000


