# Public, read-only Horizon endpoint. Mainnet by default (see ARCHITECTURE.md
# for why mainnet over testnet). No API key required.
HORIZON_URL=https://horizon.stellar.org

# How often the backend polls Horizon, in milliseconds.
POLL_INTERVAL_MS=6000

# Port the backend HTTP server listens on.
PORT=4000

# Origin allowed to call this API (frontend dev server by default).
CORS_ORIGIN=http://localhost:5173

# Threshold ratio (0.0 - 1.0) above which network congestion is banded "high" (default 0.8).
CONGESTION_ALERT_THRESHOLD=0.8

